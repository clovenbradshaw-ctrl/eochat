node_modules/
memory/
.derived/
chats/
audit-output/

# Runtime state the server writes as it is used — one reader's deleted sources
# and fetched pages. Committing these ships someone else's browsing history as
# this repo's default data, which is exactly what a fresh clone must not have.
server/recycle-bin.json
server/web-history.jsonl
.DS_Store
sonata.mid
*.mid

# Scratch working directories the agentic eval creates and destroys per run —
# not results (those are eval/results/), just throwaway sandbox state.
eval/.sandbox/

# eoCode tab's live workspaces — whatever the agent reads/writes while working
# on a real task, not a fixture this repo ships.
eocode-workspace/

# Claude Code worktree scratch space — isolated checkouts for parallel work,
# not part of this repo's own tree.
.claude/worktrees/

# Resumability progress file for eval/chat/live/build-transcript.mjs — an
# in-flight ledger of a real API call sequence, not a deliverable. The
# finished eval/chat/live/transcripts/milkshake.transcript.json IS committed.
eval/chat/live/transcripts/*.progress.jsonl
