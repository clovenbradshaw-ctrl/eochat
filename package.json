{
  "name": "eochat",
  "version": "1.0.0",
  "type": "module",
  "description": "A chat that answers from your actual documents, with [1] citations to real passages — not hallucinated.",
  "license": "MIT",
  "scripts": {
    "start": "UV_THREADPOOL_SIZE=16 node server/proxy.js",
    "ui": "python3 -m http.server 8899 --directory ui",
    "probe:retrieval": "node scripts/probe-retrieval.mjs",
    "probe:order": "node scripts/probe-prompt-order.mjs",
    "probe:instruction-gate": "node scripts/probe-instruction-gate.mjs",
    "test:affordances": "node scripts/test-affordances.mjs",
    "test:conversation-store": "node scripts/test-conversation-store.mjs",
    "test:turn-controller": "node scripts/test-turn-controller.mjs",
    "test:prosify-cue": "node scripts/test-prosify-cue.mjs",
    "test:prosify-integration": "node scripts/test-prosify-integration.mjs",
    "test:engine-ground": "node scripts/test-engine-ground.mjs",
    "test:senses-runtime": "node scripts/test-senses-runtime.mjs",
    "test:project-instructions": "node scripts/test-project-instructions.mjs",
    "check:laws": "node scripts/check-laws.mjs",
    "postinstall": "git submodule update --init --recursive || true; node scripts/link-vendor-workspaces.mjs || true",
    "probe:support-gate": "node scripts/probe-support-gate.mjs",
    "probe:support-conversation": "node scripts/probe-support-conversation.mjs",
    "probe:instruction-review": "node scripts/probe-instruction-review.mjs",
    "check:instructions": "node scripts/check-instruction-laws.mjs"
  },
  "dependencies": {
    "@eoreader/engine": "file:../eoreader6/packages/engine",
    "@eoreader/host": "file:../eoreader6/packages/host",
    "@eoreader/spec": "file:../eoreader6/packages/spec"
  }
}
